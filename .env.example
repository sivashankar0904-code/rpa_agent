# Transport: stdio (local MCP clients) or http (remote / container)
RPA_TRANSPORT=stdio
RPA_HOST=127.0.0.1
RPA_PORT=8000
RPA_LOG_LEVEL=INFO

# Sandbox root for file tools (created on startup)
RPA_WORKSPACE_DIR=workspace
RPA_MAX_FILE_BYTES=1000000

# Applications the server may launch: JSON object of alias -> command, or
# {"command": ..., "process_name": ...}. Anything not listed is rejected by open_application.
# Set process_name for launcher-stub apps (Notepad, Calculator) so the real process is tracked.
RPA_ALLOWED_APPS={"notepad": {"command": "notepad.exe", "process_name": "Notepad.exe"}, "calc": {"command": "calc.exe", "process_name": "CalculatorApp.exe"}}
