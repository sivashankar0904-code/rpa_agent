# Transport: stdio (local MCP clients) or http (remote / container)
RPA_TRANSPORT=stdio
RPA_HOST=127.0.0.1
RPA_PORT=8000
RPA_LOG_LEVEL=INFO

# Sandbox root for file tools (created on startup)
RPA_WORKSPACE_DIR=workspace
RPA_MAX_FILE_BYTES=1000000

# Applications open_application refuses to launch: a JSON list matched case-insensitively against
# an app's display name, executable name (with or without .exe) and, for Store apps, package name.
# Unset = built-in default (shells, script hosts, regedit, msiexec, terminals). Setting it
# REPLACES the default list, so include those entries if you still want them blocked.
# RPA_BLOCKED_APPS=["cmd.exe", "powershell.exe", "pwsh.exe", "Microsoft.WindowsTerminal"]
